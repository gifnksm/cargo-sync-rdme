#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 1 ]]; then
    echo "Usage: $0 <target>" >&2
    exit 1
fi

target="$1"

cargo_metadata="$(cargo metadata --no-deps --format-version 1)"
workspace_root="$(jq -crb '.workspace_root' <<<"${cargo_metadata}")"
root_package_manifest_path="${workspace_root}/Cargo.toml"
root_package_id="$(jq -rb --arg path "${root_package_manifest_path}" '.packages[] | select(.manifest_path == $path) | .id' <<<"${cargo_metadata}")"

if [[ -z "${root_package_id}" ]]; then
    echo "error: could not find root package for workspace: ${workspace_root}" >&2
    exit 1
fi

root_package="$(jq -cb --arg pkgid "${root_package_id}" '.packages[] | select(.id == $pkgid)' <<<"${cargo_metadata}")"

case "${target}" in
name)
    name="$(jq -rb '.name' <<<"${root_package}")"
    if [[ "${name}" == "null" ]]; then
        echo "error: name field is not set in root package manifest: ${root_package_manifest_path}" >&2
        exit 1
    fi
    echo "${name}"
    ;;
msrv)
    msrv="$(jq -rb '.rust_version' <<<"${root_package}")"
    if [[ "${msrv}" == "null" ]]; then
        echo "error: rust-version field is not set in root package manifest: ${root_package_manifest_path}" >&2
        exit 1
    fi
    echo "${msrv}"
    ;;
version)
    version="$(jq -rb '.version' <<<"${root_package}")"
    if [[ "${version}" == "null" ]]; then
        echo "error: version field is not set in root package manifest: ${root_package_manifest_path}" >&2
        exit 1
    fi
    echo "${version}"
    ;;
*)
    echo "error: unknown target: ${target}" >&2
    exit 1
    ;;
esac
