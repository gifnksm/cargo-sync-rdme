#!/usr/bin/env bash

set -euo pipefail

# Print the latest stable version of a crate.
# Exit with status 2 if the crate does not exist or has no stable release.
# Other failures, such as network or API errors, are treated as errors.

if [[ $# -ne 1 ]]; then
    echo "Usage: $0 <package>" >&2
    exit 1
fi

package_name="$1"

user_agent="print-latest-version (https://github.com/gifnksm/cargo-sync-rdme)"

response_file="$(mktemp)"
trap 'rm -f -- "${response_file}"' EXIT

# Capture the HTTP status separately to distinguish unpublished crates
# (404) from API failures.
status="$(curl -sSL --retry 3 \
    -A "${user_agent}" \
    -o "$response_file" \
    -w '%{http_code}' \
    "https://crates.io/api/v1/crates/${package_name}")"
case "${status}" in
200)
    # jq -e exits with status 4 when no valid version is produced.
    jq -er '.crate.max_stable_version | select(type == "string" and length > 0)' "${response_file}" || {
        status=$?
        if [[ "${status}" -eq 4 ]]; then
            exit 2
        fi
        exit 1
    }
    ;;
404)
    exit 2
    ;;
*)
    echo "crates.io API returned HTTP ${status}" >&2
    exit 1
    ;;
esac
