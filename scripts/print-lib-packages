#!/usr/bin/env bash

set -euo pipefail

cargo_metadata="$(cargo metadata --no-deps --format-version 1)"

# Match the package kinds accepted by Cargo's `--lib` flag, not just
# `cargo metadata` targets with `kind == "lib"`. Metadata exposes concrete
# library target kinds such as `rlib`, `dylib`, `cdylib`, `staticlib`, and
# `proc-macro`, all of which `cargo rustdoc --lib` accepts.
jq -r '
    .workspace_members as $members
    | .packages[]
    | select(.id as $id | $members | index($id))
    | select(any(.targets[]; any(.kind[];
        . == "lib"
        or . == "rlib"
        or . == "dylib"
        or . == "cdylib"
        or . == "staticlib"
        or . == "proc-macro"
    )))
    | .name
' <<<"${cargo_metadata}" | tr -d '\r'
