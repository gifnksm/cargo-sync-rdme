{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],

  // Allow Renovate to open or refresh dependency update branches on Mondays
  // without depending on an exact run time.
  "schedule": ["* * * * 1"],

  // Override config:recommended path exclusions so examples, tests, and fixtures stay in scope.
  "ignorePaths": [],

  // Keep lock file maintenance enabled so indirect dependencies in lock files
  // still get refreshed on Mondays.
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* * * * 1"]
  },

  // Override Cargo's default rangeStrategy so direct dependency updates also
  // refresh Cargo.toml instead of only updating Cargo.lock.
  "cargo": {
    "rangeStrategy": "bump"
  },

  "packageRules": [
    {
      "description": "Keep Cargo lock file maintenance in a dedicated PR",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "branchTopic": "cargo-lock-file-maintenance",
      "groupName": "Cargo lock file maintenance",
      "commitMessageTopic": "for Cargo.lock"
    },
    {
      "description": "Disable mise lock file maintenance",
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "enabled": false
    },
    {
      "description": "Group compatible Cargo updates",
      "matchManagers": ["cargo"],
      "matchCurrentVersion": "!/^0\\./",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Cargo compatible dependencies"
    },
    {
      "description": "Group compatible 0.1+ Cargo patch updates",
      "matchManagers": ["cargo"],
      "matchCurrentVersion": "/^0\\.[1-9]\\d*\\./",
      "matchUpdateTypes": ["patch"],
      "groupName": "Cargo compatible dependencies"
    }
  ]
}
