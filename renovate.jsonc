{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)"
  ],

  "minimumReleaseAge": "3 days",
  "labels": ["dependencies"],

  // Override config:recommended path exclusions so examples, tests, and fixtures stay in scope.
  "ignorePaths": [],

  // Keep lock file maintenance enabled so indirect dependencies in lock files
  // still get refreshed on Mondays.
  "lockFileMaintenance": {
    "enabled": true
  },

  // Override Cargo's default rangeStrategy so direct dependency updates also
  // refresh Cargo.toml instead of only updating Cargo.lock.
  "cargo": {
    "rangeStrategy": "bump"
  },

  "packageRules": [
    {
      "description": "Skip minimum release age checks for GitHub runners because the datasource does not provide release timestamps",
      "matchDatasources": ["github-runners"],
      "minimumReleaseAge": null
    },
    {
      "description": "Disable mise lock file maintenance",
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "enabled": false
    }
  ],

  "customManagers": [
    {
      // Parse matrix runner labels as YAML so formatting and comments do not affect extraction.
      // Direct runs-on labels are handled by the built-in github-actions manager.
      "customType": "jsonata",
      "fileFormat": "yaml",
      "managerFilePatterns": [".github/workflows/*.{yml,yaml}"],
      "matchStrings": [
        "jobs.*.strategy.matrix.**.os[$type($) = 'string' and $substringBefore($, '-') in ['ubuntu', 'macos', 'windows']].{'depName': $substringBefore($, '-'), 'currentValue': $substringAfter($, '-')}"
      ],
      "datasourceTemplate": "github-runners",
      "versioningTemplate": "docker"
    }
  ]
}
