{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)"
  ],

  "minimumReleaseAge": "3 days",
  "labels": ["dependencies"],

  // Override config:recommended path exclusions so examples, tests, and fixtures stay in scope.
  "ignorePaths": [],

  // Keep lock file maintenance enabled so indirect dependencies in lock files
  // still get refreshed on Mondays.
  "lockFileMaintenance": {
    "enabled": true
  },

  // Override Cargo's default rangeStrategy so direct dependency updates also
  // refresh Cargo.toml instead of only updating Cargo.lock.
  "cargo": {
    "rangeStrategy": "bump"
  },

  "packageRules": [
    {
      "description": "Disable mise lock file maintenance",
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "enabled": false
    }
  ]
}
